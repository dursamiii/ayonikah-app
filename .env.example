# Public URL compiled into the Next.js frontend image and used in browser requests.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Container paths; local development defaults are documented in README.md.
DATABASE_PATH=/data/planner.sqlite3
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=5242880
